# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datasets
datasets/

# Firebase / Secrets
lib/firebase.ts
.firebaserc
firebase.json

# Python AI model artifacts
pancrescan/PancreScan/*.pt
pancrescan/PancreScan/*.pth
pancrescan/PancreScan/*.pkl
pancrescan/PancreScan/__pycache__/
pancrescan/PancreScan/.venv/
pancrescan/PancreScan/venv/

# VSCode local settings
.vscode/
